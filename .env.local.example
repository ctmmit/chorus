# Copy to .env.local and fill. .env.local is gitignored — never commit real keys.
# All three are Tier-A per AUTOPILOT (paid services / new credentials).

ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
CHORUS_EMAIL_FROM=
# Optional voice id overrides (single-voice host / two-host dialogue). Unset
# means the service's built-in defaults (see chorus/audio.py) for whichever
# voices a request's `profile` doesn't set explicitly.
ELEVENLABS_VOICE_ID=
# Two-host dialogue's cohost voice (Phase E, docs/DEVELOPMENT_PLAN.md §4) —
# only used when a request's `profile.format` is "dialogue".
ELEVENLABS_COHOST_VOICE_ID=
# Bearer token callers must send (Authorization: Bearer <token>). REQUIRED when
# either provider key above is set — the service refuses to start otherwise,
# because an open endpoint with real keys is an open wallet. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHORUS_API_TOKEN=
# Managed transcript API (Supadata) — YouTube captions for live episodes.
# Dev/tests use the pre-transcribed files in fixtures/transcripts/, so this is
# only needed for live (non-fixture) episodes.
TRANSCRIPT_API_KEY=
# Deepgram STT — last-resort transcript fallback when neither Supadata nor an
# RSS podcast:transcript tag has anything (transcribes the episode audio).
DEEPGRAM_API_KEY=
# SSRF guard (chorus/netguard.py) escape hatch: set to 1 only to let RSS/
# Deepgram fetches use plain http:// (e.g. a local fixture server in tests).
# Never set this in a real deployment. Unset (the default) allows https only;
# either way every URL is still resolved and checked against loopback/
# private/link-local/reserved ranges before it is fetched.
CHORUS_ALLOW_HTTP=

# --- Phase B (Vercel port) — all optional locally; local dev/tests always ---
# --- run SQLite + local artifacts + BackgroundTasks regardless of these. ---
# Neon Postgres DSN (pooled). Set automatically by the Vercel Marketplace
# Neon integration in production/preview; unset locally means SqliteJobStore.
DATABASE_URL=
# Vercel Blob read-write token. Set automatically by the Vercel Marketplace
# Blob integration; unset locally means LocalArtifactStore (artifacts/ dir).
BLOB_READ_WRITE_TOKEN=
# Inngest event key (sending events) — from the Inngest app dashboard or its
# Vercel integration. Both this and INNGEST_SIGNING_KEY must be set for the
# durable-step InngestRunner to activate; unset means BackgroundRunner.
INNGEST_EVENT_KEY=
# Inngest signing key (verifying that /api/inngest requests came from
# Inngest, not an open trigger of the pipeline).
INNGEST_SIGNING_KEY=

# --- Phase F (Weekly email, docs/DEVELOPMENT_PLAN.md §3) -------------------
# Vercel Cron convention: guards POST/GET /internal/cron/tick, the
# subscription fan-out trigger for deployments without Inngest (or a second
# trigger alongside it). Vercel sets the Authorization header itself once
# this is a project env var (see vercel.json's "crons" entry). Generate the
# same way as CHORUS_API_TOKEN.
CRON_SECRET=
# HMAC key signing unsubscribe links. Falls back to CHORUS_API_TOKEN, then a
# per-process random secret (existing links stop verifying after a
# restart) — set this explicitly so links in already-delivered emails keep
# working across deploys.
CHORUS_UNSUBSCRIBE_SECRET=
# The deployed service's own base URL (e.g. https://chorus.up.railway.app),
# used to build absolute links (the rendered audio episode, the unsubscribe
# link) in a subscription email from a cron-triggered invocation that has no
# incoming request to infer its host from. Unset falls back to
# http://localhost:8000 outside of a request context — set this in
# production.
CHORUS_PUBLIC_URL=
