# Copy to .env.local and fill. .env.local is gitignored — never commit real keys.
# All three are Tier-A per AUTOPILOT (paid services / new credentials).

ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
CHORUS_EMAIL_FROM=
# Bearer token callers must send (Authorization: Bearer <token>). REQUIRED when
# either provider key above is set — the service refuses to start otherwise,
# because an open endpoint with real keys is an open wallet. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHORUS_API_TOKEN=
# Managed transcript API (Supadata or TranscriptAPI) — production transcript path.
# Dev/tests use the pre-transcribed files in fixtures/transcripts/, so this is
# only needed for live (non-fixture) episodes.
TRANSCRIPT_API_KEY=
