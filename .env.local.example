# Copy to .env.local and fill. .env.local is gitignored — never commit real keys.
# All three are Tier-A per AUTOPILOT (paid services / new credentials).

ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
CHORUS_EMAIL_FROM=
# Optional voice id overrides (single-voice host / two-host dialogue). Unset
# means the service's built-in defaults (see chorus/audio.py) for whichever
# voices a request's `profile` doesn't set explicitly.
ELEVENLABS_VOICE_ID=
# Two-host dialogue's cohost voice (Phase E, docs/DEVELOPMENT_PLAN.md §4) —
# only used when a request's `profile.format` is "dialogue".
ELEVENLABS_COHOST_VOICE_ID=
# Bearer token callers must send (Authorization: Bearer <token>). REQUIRED when
# either provider key above is set — the service refuses to start otherwise,
# because an open endpoint with real keys is an open wallet. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHORUS_API_TOKEN=
# Transcript ladder, in order (each rung runs only when its key is set):
#   fixture -> RSS podcast:transcript -> AssemblyAI -> Deepgram -> Supadata
# Dev/tests use the pre-transcribed files in fixtures/transcripts/, so none of
# these keys is needed except for live (non-fixture) episodes.
# AssemblyAI STT (Universal-3.5 Pro + speaker labels) on the RSS enclosure
# audio: the primary ASR tier when an episode has no publisher transcript.
ASSEMBLYAI_API_KEY=
# Deepgram STT (Nova-3 + diarization) — backup ASR when AssemblyAI is unset or
# fails (transcribes the same enclosure audio).
DEEPGRAM_API_KEY=
# Managed transcript API (Supadata) — native YouTube captions only, last
# resort for episodes with no RSS audio (mode=native: never bills AI).
TRANSCRIPT_API_KEY=
# SSRF guard (chorus/netguard.py) escape hatch: set to 1 only to let RSS/
# Deepgram fetches use plain http:// (e.g. a local fixture server in tests).
# Never set this in a real deployment. Unset (the default) allows https only;
# either way every URL is still resolved and checked against loopback/
# private/link-local/reserved ranges before it is fetched.
CHORUS_ALLOW_HTTP=
# "production" refuses startup with no CHORUS_API_TOKEN even when no provider
# key above is configured (R2, docs/REVIEW_WAVE1.md) — a belt-and-suspenders
# declaration for a real, access-controlled deployment that currently only
# has mock providers. Unset/anything else: the existing "no token needed
# unless a provider key is set" behavior.
CHORUS_ENV=
# Base URL of the web app (web/). When set, the key email from POST /keys also
# carries a sign-in link: <url>/subscribe#token=<key> (a URL fragment, so the
# key is never sent to a server or written to a log). Unset: key text only.
CHORUS_VIEWER_URL=
# Optional YouTube Data API v3 key: lets POST /podcasts/resolve turn a YouTube
# @handle, /c/ or /user/ URL into a channel id (channels.list, 1 quota unit).
# Unset: those URL forms answer 422 and ask for the /channel/UC... URL. YouTube
# pages are never scraped, and channel feeds themselves need no key.
YOUTUBE_API_KEY=
# Comma-separated allowlist of browser origins allowed to call this API
# cross-origin (R13) — e.g. https://chorus-viewer.vercel.app. Empty/unset:
# no CORS headers at all (today's behavior; same-origin/non-browser callers
# only). Needed for web/ (the viewer) deployed to a different origin.
CHORUS_CORS_ORIGINS=

# --- R3 (docs/REVIEW_WAVE1.md): self-serve spend controls -------------------
# Per-owner rolling-24h job quota and concurrent in-flight job quota,
# enforced before every job creation (POST /digest, /digest/select,
# /subscriptions/{id}/run, MCP submit tools). Master token is exempt.
# Defaults: 20 and 3.
CHORUS_MAX_JOBS_PER_DAY=
CHORUS_MAX_INFLIGHT_JOBS=
# Per-client-IP token bucket on POST /keys, in addition to the existing
# per-email-per-hour limit. In-process only — on serverless with multiple
# live instances this is a PER-INSTANCE ceiling, not a global one. Default: 3.
CHORUS_KEY_ISSUE_PER_IP_PER_HOUR=
# Comma-separated allowlist of email domains permitted to self-serve a key
# (e.g. mycompany.com,contractor.example). Empty/unset: any domain, matching
# today's open self-serve behavior.
CHORUS_KEY_ALLOWED_EMAIL_DOMAINS=

# --- Phase B (Vercel port) — all optional locally; local dev/tests always ---
# --- run SQLite + local artifacts + BackgroundTasks regardless of these. ---
# Neon Postgres DSN (pooled). Set automatically by the Vercel Marketplace
# Neon integration in production/preview; unset locally means SqliteJobStore
# (and the matching SQLite key/subscription/persona store + transcript
# cache — chorus/config_env.py selects every backend by DATABASE_URL, never
# builds a SQLite one first and swaps it out, R1).
DATABASE_URL=
# Local-only escape hatch: overrides the repository-root default SQLite db
# path (chorus.db) — e.g. point it at /tmp on a filesystem that is read-only
# outside /tmp. Never needed when DATABASE_URL is set (no SQLite store is
# constructed at all in that mode); unset means the repository-root default.
CHORUS_DB_PATH=
# Postgres-mode only: a shared deployment can have more than one live
# instance, so the startup sweep only marks a stuck job failed once it has
# been untouched for this many seconds (R6, docs/REVIEW_WAVE1.md) — a fresh
# cold start must not stomp another instance's actively-running job. SQLite
# always sweeps everything immediately (it is inherently single-process).
# Default: 1800 (30 minutes).
CHORUS_STALE_JOB_SECONDS=
# Vercel Blob read-write token. Set automatically by the Vercel Marketplace
# Blob integration; unset locally means LocalArtifactStore (artifacts/ dir).
BLOB_READ_WRITE_TOKEN=
# Set automatically by Vercel on any project a Blob store is connected to.
# Used to reconstruct a private blob's download URL for VercelBlobStore.get()
# (R5, docs/REVIEW_WAVE1.md: audio is uploaded with x-vercel-blob-access:
# private and only ever served through the owner-checked GET
# /artifacts/{name} route — never a bare, public Blob URL). Needed for a
# cold instance to serve audio it did not itself upload.
BLOB_STORE_ID=
# Inngest event key (sending events) — from the Inngest app dashboard or its
# Vercel integration. Both this and INNGEST_SIGNING_KEY must be set for the
# durable-step InngestRunner to activate; unset means BackgroundRunner.
INNGEST_EVENT_KEY=
# Inngest signing key (verifying that /api/inngest requests came from
# Inngest, not an open trigger of the pipeline).
INNGEST_SIGNING_KEY=

# --- Phase F (Weekly email, docs/DEVELOPMENT_PLAN.md §3) -------------------
# Vercel Cron convention: guards POST/GET /internal/cron/tick, the
# subscription fan-out trigger for deployments without Inngest (or a second
# trigger alongside it). Vercel sets the Authorization header itself once
# this is a project env var (see vercel.json's "crons" entry). Generate the
# same way as CHORUS_API_TOKEN.
CRON_SECRET=
# HMAC key signing unsubscribe links. Falls back to CHORUS_API_TOKEN, then a
# per-process random secret (existing links stop verifying after a
# restart) — set this explicitly so links in already-delivered emails keep
# working across deploys.
CHORUS_UNSUBSCRIBE_SECRET=
# The deployed service's own base URL (e.g. https://chorus.up.railway.app),
# used to build absolute links (the rendered audio episode, the unsubscribe
# link) in a subscription email from a cron-triggered invocation that has no
# incoming request to infer its host from. Unset falls back to
# http://localhost:8000 outside of a request context — set this in
# production.
CHORUS_PUBLIC_URL=
